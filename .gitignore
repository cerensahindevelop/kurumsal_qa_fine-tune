# --- Model ağırlıkları ve büyük ikili dosyalar ---
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
models/
hf_cache/
.cache/

# --- Deney çıktıları: küçük metin dosyaları (config, metrik JSON, run.log, TensorBoard) kalır ---
experiments/**/checkpoint-*/
experiments/**/adapter_model*
experiments/**/optimizer.pt
experiments/**/merged/
experiments/**/*.pid

# --- Üretilen veri: kurum verisinde sızıntıyı önlemek için JSONL'ler git'e girmez ---
data/**/*.jsonl
data/**/*.parquet
!data/dataset_info.json

# --- Model cevapları (responses; büyük ve kurum verisinde hassas) ---
evaluation/responses/
evaluation/**/*_responses.jsonl
# Eski adlar: tarihî degerlendirme/ klasörü ve eski adla üretilmiş dosyalar da hâlâ dışarıda kalır.
evaluation/cevaplar/
evaluation/**/*_cevaplar.jsonl
degerlendirme/cevaplar/
degerlendirme/**/*_cevaplar.jsonl

# --- Python / ortam ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
wheels/

# --- Gizli / yerel ayarlar ---
.env
.claude/settings.local.json

# --- Erişim engeli testi: yalnızca test sırasında geçici oluşturulur, git'e girmez ---
security_check/
